NODE_ENV=development
PORT=8080

# Tao .env rieng va thay cac placeholder ben duoi.
# Khong commit .env that.
DATABASE_URL="mysql://root:DOI_MAT_KHAU_MYSQL@127.0.0.1:3306/quan_ly_nha_hang"

JWT_ACCESS_SECRET=DOI_BANG_CHUOI_NGAU_NHIEN_DAI_IT_NHAT_32_KY_TU
JWT_ACCESS_EXPIRES_SECONDS=900
JWT_REFRESH_SECRET=DOI_BANG_CHUOI_NGAU_NHIEN_KHAC_DAI_IT_NHAT_32_KY_TU
JWT_REFRESH_EXPIRES_SECONDS=2592000

RESET_PASSWORD_EXPIRES_MINUTES=30

# Dev Vite + Playwright preview
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173

# Seed Admin dau tien
SEED_ADMIN_EMAIL=admin@example.local
SEED_ADMIN_PASSWORD=DOI_MAT_KHAU_ADMIN_MANH
SEED_ADMIN_HO_TEN=Quan tri vien

# Seed demo local cho giao dien bao ve
# Chay bang: DEMO_SEED_CONFIRM=YES npm run seed:demo
# Script tu choi production, database CI va MySQL khong phai local.
DEMO_SEED_CONFIRM=NO

# Tuy chon: neu bo trong, seed chi thay cac gia tri placeholder bang branding demo mac dinh.
# DEMO_TEN_NHA_HANG=Nha hang Huong Viet
# DEMO_DIA_CHI_NHA_HANG=Ha Noi, Viet Nam
# DEMO_SO_DIEN_THOAI_NHA_HANG=024 7300 8899
# DEMO_EMAIL_NHA_HANG=datban@huongviet.vn

# Tuy chon khi trinh dien: an cac danh muc/mon cu khoi public menu, KHONG xoa du lieu.
# Dung cung DEMO_SEED_CONFIRM=YES.
DEMO_ISOLATE_PUBLIC_MENU=NO

# Tuy chon khi trinh dien: public booking chi su dung khu vuc/ban demo HV.
# Khong xoa du lieu cu; chi chuyen khu vuc/ban cu sang trang thai khong phuc vu.
DEMO_ISOLATE_PUBLIC_BOOKING=NO
# Runtime image uploads
UPLOAD_DIR=uploads
PUBLIC_BACKEND_URL=http://localhost:8080
